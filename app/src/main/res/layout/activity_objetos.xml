<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activity_objetos">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selecciona el boton correspondiente"
        android:textSize="30dp"
        android:layout_marginTop="50dp"
        android:gravity="center"
        android:layout_gravity="center"
        android:textStyle="bold"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="5dp">
            <ImageButton
                android:id="@+id/imgBtnAud1"
                android:layout_width="115dp"
                android:layout_height="115dp"
                android:text="Audio 1"
                android:src="@drawable/gato"
                android:scaleType="centerCrop"
                android:background="@android:color/transparent" />
            <ImageButton
                android:id="@+id/imgBtnAud2"
                android:layout_width="115dp"
                android:layout_height="115dp"
                android:layout_marginTop="25dp"
                android:text="Audio 2"
                android:src="@drawable/gato"
                android:scaleType="centerCrop"
                android:background="@android:color/transparent"/>
            <ImageButton
                android:id="@+id/imgBtnAud3"
                android:layout_width="115dp"
                android:layout_height="115dp"
                android:layout_marginTop="25dp"
                android:text="Audio 3"
                android:src="@drawable/gato"
                android:scaleType="centerCrop"
                android:background="@android:color/transparent"/>
            <ImageButton
                android:id="@+id/imgBtnAud4"
                android:layout_width="115dp"
                android:layout_height="115dp"
                android:layout_marginTop="25dp"
                android:text="Audio 4"
                android:src="@drawable/gato"
                android:scaleType="centerCrop"
                android:background="@android:color/transparent"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="5dp">
            <Button
                android:id="@+id/btnObj1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Playa"
                android:textColor="#505070"
                android:backgroundTint="@color/amarillo"
                android:textSize="30dp"
                android:textStyle="bold"/>
            <Button
                android:id="@+id/btnObj2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="80dp"
                android:text="Bosque"
                android:textColor="#505070"
                android:backgroundTint="@color/amarillo"
                android:textSize="30dp"
                android:textStyle="bold"/>
            <Button
                android:id="@+id/btnObj3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="80dp"
                android:text="Desierto"
                android:textColor="#505070"
                android:backgroundTint="@color/amarillo"
                android:textSize="30dp"
                android:textStyle="bold"/>
            <Button
                android:id="@+id/btnObj4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="80dp"
                android:text="Montaña"
                android:textColor="#505070"
                android:backgroundTint="@color/amarillo"
                android:textSize="30dp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>