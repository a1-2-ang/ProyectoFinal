<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activity_naturaleza">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selecciona el boton correspondiente"
        android:textSize="30dp"
        android:layout_marginTop="50dp"
        android:gravity="center"
        android:layout_gravity="center"
        android:textStyle="bold"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="5dp">
            <Button
                android:id="@+id/btnAud1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Audio 1"
                android:textColor="@color/white"
                android:backgroundTint="@color/azul_bajo"
                android:textSize="30dp"
                android:textStyle="bold"/>
            <Button
                android:id="@+id/btnAud2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Audio 2"
                android:textColor="@color/white"
                android:backgroundTint="@color/azul_bajo"
                android:textSize="30dp"
                android:textStyle="bold"/>
            <Button
                android:id="@+id/btnAud3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Audio 3"
                android:textColor="@color/white"
                android:backgroundTint="@color/azul_bajo"
                android:textSize="30dp"
                android:textStyle="bold"/>
            <Button
                android:id="@+id/btnAud4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Audio 4"
                android:textColor="@color/white"
                android:backgroundTint="@color/azul_bajo"
                android:textSize="30dp"
                android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="5dp">
            <Button
                android:id="@+id/btnNat1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Playa"
                android:textColor="@color/white"
                android:backgroundTint="@color/azul_bajo"
                android:textSize="30dp"
                android:textStyle="bold"/>
            <Button
                android:id="@+id/btnNat2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Bosque"
                android:textColor="@color/white"
                android:backgroundTint="@color/azul_bajo"
                android:textSize="30dp"
                android:textStyle="bold"/>
            <Button
                android:id="@+id/btnNat3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Desierto"
                android:textColor="@color/white"
                android:backgroundTint="@color/azul_bajo"
                android:textSize="30dp"
                android:textStyle="bold"/>
            <Button
                android:id="@+id/btnNat4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Montaña"
                android:textColor="@color/white"
                android:backgroundTint="@color/azul_bajo"
                android:textSize="30dp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>