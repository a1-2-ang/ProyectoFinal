<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Niveles">

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="145dp"
        android:layout_marginTop="82dp"
        android:layout_marginEnd="145dp"
        android:text="Elige un nivel"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnN1"
        android:layout_width="319dp"
        android:layout_height="74dp"
        android:layout_marginStart="46dp"
        android:layout_marginTop="54dp"
        android:layout_marginEnd="46dp"
        android:text="Nivel 1"
        android:textSize="30dp"
        android:backgroundTint="@color/Nivel"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView3" />

    <Button
        android:id="@+id/btnN2"
        android:layout_width="319dp"
        android:layout_height="74dp"
        android:layout_marginStart="46dp"
        android:layout_marginTop="23dp"
        android:layout_marginEnd="46dp"
        android:text="Nivel 2"
        android:textSize="30dp"
        android:backgroundTint="@color/Nivel"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnN1" />

    <Button
        android:id="@+id/btnN3"
        android:layout_width="319dp"
        android:layout_height="74dp"
        android:layout_marginStart="46dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="46dp"
        android:text="Nivel 3"
        android:backgroundTint="@color/Nivel"
        android:textSize="30dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnN2" />

    <Button
        android:id="@+id/btnN4"
        android:layout_width="319dp"
        android:layout_height="74dp"
        android:layout_marginStart="46dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="46dp"
        android:text="Nivel 4"
        android:textSize="30dp"
        android:backgroundTint="@color/Nivel"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnN3" />

    <Button
        android:id="@+id/btnN5"
        android:layout_width="319dp"
        android:layout_height="74dp"
        android:layout_marginStart="46dp"
        android:layout_marginTop="17dp"
        android:layout_marginEnd="46dp"
        android:text="Nivel 5"
        android:textSize="30dp"
        android:textStyle="bold"
        android:backgroundTint="@color/Nivel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnN4" />

</androidx.constraintlayout.widget.ConstraintLayout>