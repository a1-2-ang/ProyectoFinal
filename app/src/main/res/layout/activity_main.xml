<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">


    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="58dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="59dp"
        android:text="Bienvenido a AUSPECTUS"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnUsuario" />

    <Button
        android:id="@+id/btn3"
        android:layout_width="173dp"
        android:layout_height="173dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text="Naturaleza"
        android:textColor="#3D3D3D"
        android:backgroundTint="#70A7B0"
        android:textSize="28sp"
        android:textStyle="bold"
        app:cornerRadius="0dp"
        app:layout_constraintEnd_toStartOf="@+id/btn4"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn1" />

    <Button
        android:id="@+id/btn2"
        android:layout_width="173dp"
        android:layout_height="173dp"
        android:layout_marginTop="88dp"
        android:layout_marginEnd="16dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:textColor="#3D3D3D"
        android:text="Acento"
        android:backgroundTint="#70A7B0"
        android:textSize="28sp"
        android:textStyle="bold"
        app:cornerRadius="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

    <Button
        android:id="@+id/btn1"
        android:layout_width="173dp"
        android:layout_height="173dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="88dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text="Animales"
        android:textSize="28sp"
        android:textColor="#3D3D3D"
        android:textStyle="bold"
        android:backgroundTint="#70A7B0"
        app:cornerRadius="0dp"
        app:layout_constraintEnd_toStartOf="@+id/btn2"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

    <Button
        android:id="@+id/btn4"
        android:layout_width="173dp"
        android:layout_height="173dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text="Sonidos de Objetos"
        android:textColor="#3D3D3D"
        android:backgroundTint="@color/Boton"
        android:textSize="28sp"
        android:textStyle="bold"
        app:cornerRadius="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn2" />


    <ImageButton
        android:id="@+id/btnUsuario"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="335dp"
        android:layout_marginTop="44dp"
        android:layout_marginEnd="28dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src="@drawable/usuarios"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardUsuario"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="100dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center_horizontal">

            <ImageButton
                android:id="@+id/BtnClose"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="end"
                android:background="@android:color/transparent"
                android:scaleType="centerCrop"
                android:src="@drawable/borrar" />

            <ImageButton
                android:id="@+id/btnPerfil"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/usuarios"
                android:background="@android:color/transparent"
                android:scaleType="centerCrop"/>

            <!-- Nombre editable -->
            <EditText
                android:id="@+id/etNombreUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Usuario"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <!-- Botón Guardar cambios -->
            <Button
                android:id="@+id/btnGuardarCambios"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guardar"/>

            <Button
                android:id="@+id/btnCerrarSesion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cerrar Sesión"/>

            <Button
                android:id="@+id/btnEliminarCuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Eliminar Cuenta"
                android:backgroundTint="@android:color/holo_red_dark"
                android:textColor="@android:color/white"/>

            <Button
                android:id="@+id/btnPuntos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver puntuación"/>

            <Switch
                android:id="@+id/switchMain"
                android:layout_width="125dp"
                android:layout_height="50dp"
                android:layout_marginTop="25dp"
                android:text="Modo de voz"
                android:checked="false"
                android:textSize="16dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:id="@+id/linLayPuntos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#35393c"
        android:paddingTop="30dp"
        android:orientation="horizontal"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Categoría"
                android:textColor="#a4d8ff"
                android:textSize="22dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Animales:"
                android:textColor="#a4d8ff"
                android:textSize="18dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Acentos:"
                android:textColor="#a4d8ff"
                android:textSize="18dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Naturaleza:"
                android:textColor="#a4d8ff"
                android:textSize="18dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Objetos:"
                android:textColor="#a4d8ff"
                android:textSize="18dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Total:"
                android:textColor="#a4d8ff"
                android:textSize="18dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Puntuación"
                android:textColor="#a4d8ff"
                android:textSize="22dp"/>
            <TextView
                android:id="@+id/txtPuntoAni"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="0"
                android:textColor="#a4d8ff"
                android:textSize="18dp"/>
            <TextView
                android:id="@+id/txtPuntoAce"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="0"
                android:textColor="#a4d8ff"
                android:textSize="18dp"/>
            <TextView
                android:id="@+id/txtPuntoNat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="0"
                android:textColor="#a4d8ff"
                android:textSize="18dp"/>
            <TextView
                android:id="@+id/txtPuntoObj"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="0"
                android:textColor="#a4d8ff"
                android:textSize="18dp"/>
            <TextView
                android:id="@+id/txtPuntoTot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="0"
                android:textColor="#a4d8ff"
                android:textSize="18dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.2">
            <ImageButton
                android:id="@+id/imgBtnPunts"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="end"
                android:background="@android:color/transparent"
                android:scaleType="centerCrop"
                android:src="@drawable/borrar"/>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>